# Same stable client; temporary local integration, separate from 8790 mock.
# Remove loopback redirect allowlist entries after public deployment acceptance.
COSPACE_OIDC_ISSUER=https://accounts.vxture.com
COSPACE_OIDC_BACKCHANNEL=https://accounts.vxture.com
COSPACE_OIDC_CLIENT_ID=cospace
COSPACE_ORIGIN=http://127.0.0.1:8791
COSPACE_OIDC_LOOPBACK_HTTP=1
# Required: platform-issued COSPACE_OIDC_CLIENT_SECRET, outside this repository.
# Required: stable Fernet COSPACE_SESSION_KEY, outside this repository.
# Optional for identity pilot; required for real business assembly:
# COSPACE_PLATFORM_API_URL=<trusted internal origin>
# COSPACE_PLATFORM_TAILNET_HTTP=1 only for explicit tailnet HTTP
# COSPACE_PLATFORM_WEBHOOK_SECRET=<private registered signing key>
# A local synthetic signing key verifies receiver mechanics only; it does not prove platform delivery.
# User-clicked plan entry; identity remains at accounts.vxture.com.
COSPACE_WEBSITE_BASE_URL=https://vxture.com
