# Host-only configuration. Fill addresses/ports from the deployment inventory
# and organization port registry. No automatic empty-state initialization.
STACK_ROOT=/srv/md0/cospace
PROJECT_NAME=cospace
APP_BIND_HOST=
APP_PUBLISH_PORT=
COSPACE_PLATFORM_API_URL=
COSPACE_PLATFORM_TAILNET_HTTP=0
# Application credentials are private files under etc/secrets; not env values.
