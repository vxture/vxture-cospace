# Raw acquisitions and generated ROS bag fixtures stay outside source history.
*.bag
*.bag.active
__pycache__/
*.pyc
.venv/
node_modules/
.pnpm-store/
dist/
.cache/
var/

# Ephemeral browser profiles and snapshots may contain authentication state.
.playwright-cli/

# Private configuration, credentials and local evidence never enter Git.
.env
*.env
.env.*
!.env.example
!*.env.example
private/
secrets/
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
output/
experiments/runs/
experiments/stack/results/
*.log
logs/
.pytest_cache/
.coverage*
coverage/
htmlcov/
*.sarif
*.tsbuildinfo
.idea/
.vscode/
.DS_Store

experiments/evidence/
