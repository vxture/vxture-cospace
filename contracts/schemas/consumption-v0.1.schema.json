{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "oneOf":[{"$ref":"#/$defs/request"},{"$ref":"#/$defs/response"}],
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":256},
  "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "ref":{"type":"object","additionalProperties":false,"required":["id","sha256"],"properties":{"id":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha"}}},
  "source":{"type":"object","additionalProperties":false,"required":["scene_id","release_id","release_sha256","truth_id","truth_sha256","view_id","view_sha256"],"properties":{
   "scene_id":{"$ref":"#/$defs/id"},"release_id":{"$ref":"#/$defs/id"},"release_sha256":{"$ref":"#/$defs/sha"},"truth_id":{"$ref":"#/$defs/id"},"truth_sha256":{"$ref":"#/$defs/sha"},"view_id":{"$ref":"#/$defs/id"},"view_sha256":{"$ref":"#/$defs/sha"}
  }},
  "request":{"type":"object","additionalProperties":false,"required":["schema_version","kind","request_id","source","package_sha256","profile_ref","frame_id","purpose","mode","max_age_s","items"],"properties":{
   "schema_version":{"const":"cospace.consumption/0.1"},"kind":{"const":"request"},"request_id":{"$ref":"#/$defs/id"},
   "source":{"$ref":"#/$defs/source"},"package_sha256":{"$ref":"#/$defs/sha"},"profile_ref":{"$ref":"#/$defs/ref"},"frame_id":{"$ref":"#/$defs/id"},
   "purpose":{"enum":["browse","measure","spatial_query","localize"]},"mode":{"enum":["historical","operational"]},
   "max_age_s":{"type":["integer","null"],"minimum":0,"maximum":315360000},
   "items":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["item_id","point"],"properties":{"item_id":{"$ref":"#/$defs/id"},"point":{}}}}
  }},
  "result":{"type":"object","additionalProperties":false,"required":["item_id","status","state","reason"],"properties":{
   "item_id":{"$ref":"#/$defs/id"},"status":{"const":"result"},"state":{"enum":["unknown","occupied","observed_free","out_of_scope"]},
   "reason":{"enum":["unobserved","synthetic_observation","degraded","conflict","missing_chunk","outside_target_scope"]}
  }},
  "error":{"type":"object","additionalProperties":false,"required":["item_id","status","error_code"],"properties":{
   "item_id":{"$ref":"#/$defs/id"},"status":{"const":"error"},"error_code":{"enum":["invalid_point","query_failed"]}
  }},
  "response":{"type":"object","additionalProperties":false,"required":["schema_version","kind","request_id","source","package_sha256","profile_ref","frame_id","mode","purpose","usage","served_at","observed_from","observed_until","valid_until","max_age_s","oldest_observation_age_s","quality","status","refusal","completeness","items","authorized","robot_ready"],"properties":{
   "schema_version":{"const":"cospace.consumption/0.1"},"kind":{"const":"response"},"request_id":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/source"},"package_sha256":{"$ref":"#/$defs/sha"},"profile_ref":{"$ref":"#/$defs/ref"},
   "frame_id":{"$ref":"#/$defs/id"},"mode":{"enum":["historical","operational"]},"purpose":{"enum":["browse","measure","spatial_query","localize"]},"usage":{"const":"historical_inspection_only"},
   "served_at":{"type":"string"},"observed_from":{"type":"string"},"observed_until":{"type":"string"},"valid_until":{"type":"null"},
   "max_age_s":{"type":["integer","null"],"minimum":0},"oldest_observation_age_s":{"type":"number","minimum":0},
   "quality":{"type":"object","additionalProperties":false,"required":["grade_label","declared_limits_met","evidence_verified","reasons"],"properties":{"grade_label":{"type":["string","null"]},"declared_limits_met":{"type":"boolean"},"evidence_verified":{"const":false},"reasons":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
   "status":{"enum":["completed","partial","refused"]},
   "refusal":{"type":["string","null"],"enum":[null,"source_mismatch","profile_mismatch","frame_mismatch","purpose_not_supported","mode_mismatch","runtime_authority_unavailable","stale_observation","quality_requirements_not_met"]},
   "completeness":{"type":"object","additionalProperties":false,"required":["requested","returned","failed","unknown","out_of_scope","status"],"properties":{
    "requested":{"type":"integer","minimum":1,"maximum":256},"returned":{"type":"integer","minimum":0,"maximum":256},"failed":{"type":"integer","minimum":0,"maximum":256},"unknown":{"type":"integer","minimum":0,"maximum":256},"out_of_scope":{"type":"integer","minimum":0,"maximum":256},"status":{"enum":["complete","partial","none"]}
   }},
   "items":{"type":"array","maxItems":256,"items":{"oneOf":[{"$ref":"#/$defs/result"},{"$ref":"#/$defs/error"}]}},
   "authorized":{"const":false},"robot_ready":{"const":false}
  }}
 }
}
