{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schema_version","package_id","data_kind","derivation","source","frame_id","origin_m","resolution_m","dimensions","chunk_shape","index_order","components","chunks"],
 "properties":{
  "schema_version":{"const":"cospace.agent-voxel/0.1"},"package_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},
  "derivation":{"const":"synthetic_fixture_not_voxelized"},
  "source":{"type":"object","additionalProperties":false,"required":["scene_id","release_id","release_sha256","truth_id","truth_sha256","view_id","view_sha256"],"properties":{
   "scene_id":{"$ref":"#/$defs/id"},"release_id":{"$ref":"#/$defs/id"},"release_sha256":{"$ref":"#/$defs/sha"},
   "truth_id":{"$ref":"#/$defs/id"},"truth_sha256":{"$ref":"#/$defs/sha"},"view_id":{"$ref":"#/$defs/id"},"view_sha256":{"$ref":"#/$defs/sha"}
  }},
  "frame_id":{"$ref":"#/$defs/id"},"origin_m":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
  "resolution_m":{"type":"number","exclusiveMinimum":0},"dimensions":{"$ref":"#/$defs/size"},"chunk_shape":{"$ref":"#/$defs/size"},
  "index_order":{"const":"x_fastest"},
  "components":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["id","role","encoding","required","depends_on"],"properties":{
   "id":{"$ref":"#/$defs/id"},"role":{"$ref":"#/$defs/id"},"encoding":{"$ref":"#/$defs/id"},"required":{"type":"boolean"},"depends_on":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
  }}},
  "chunks":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["index","member"],"properties":{
   "index":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"integer","minimum":0,"maximum":4095}},
   "member":{"type":"object","additionalProperties":false,"required":["path","sha256","bytes"],"properties":{"path":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha"},"bytes":{"type":"integer","minimum":1,"maximum":8388608}}}
  }}}
 },
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":256},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "size":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"integer","minimum":1,"maximum":4096}}
 }
}
