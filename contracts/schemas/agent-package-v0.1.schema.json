{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_id", "data_kind", "source", "frame", "scope", "profile", "components", "validity"],
  "properties": {
    "schema_version": {"const": "cospace.agent-package/0.1"},
    "package_id": {"type": "string", "pattern": "^agent-[0-9a-f]{32}$"},
    "data_kind": {"const": "synthetic"},
    "source": {"type": "object", "additionalProperties": false,
      "required": ["scene_id", "release_id", "truth_version_id", "view_version_id", "view_kind", "package_sha256", "release_sha256", "truth_sha256", "view_sha256"],
      "properties": {
        "scene_id": {"$ref": "#/$defs/id"}, "release_id": {"$ref": "#/$defs/id"},
        "truth_version_id": {"$ref": "#/$defs/id"}, "view_version_id": {"$ref": "#/$defs/id"},
        "view_kind": {"const": "machine"}, "package_sha256": {"$ref": "#/$defs/sha"},
        "release_sha256": {"$ref": "#/$defs/sha"}, "truth_sha256": {"$ref": "#/$defs/sha"}, "view_sha256": {"$ref": "#/$defs/sha"}
      }},
    "frame": {"type": "object"},
    "scope": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "profile": {"const": "synthetic-region-reading/0.1"},
    "validity": {"const": "unverified_sample_only"},
    "components": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "role", "encoding", "required", "depends_on", "member"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"},
        "encoding": {"$ref": "#/$defs/id"}, "required": {"type": "boolean"},
        "depends_on": {"type": "array", "uniqueItems": true, "maxItems": 16, "items": {"$ref": "#/$defs/id"}},
        "member": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
          "properties": {"path": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}}}
      }}}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
