{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persisted build process index 0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "cospace.build-process/0.1"
    },
    "space_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "input_id": {
      "type": "string"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tracking_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "recording",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "frame_id": {
      "const": "first_depth_camera_anchor"
    },
    "axes": {
      "const": [
        "right",
        "down",
        "forward"
      ]
    },
    "unit": {
      "const": "m"
    },
    "input_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "available_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "processed_frames": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_frames": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_reason": {
      "const": "no_existing_prefix_pose"
    },
    "source_clock": {
      "const": "filename_time_unverified_utc"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_model_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "type": "string"
    },
    "input_binding": {
      "type": "object"
    },
    "origin_time_us": {
      "type": "integer"
    },
    "point_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2500000
    },
    "frames": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "relative_time_us": {
            "type": "integer",
            "minimum": 0
          },
          "source_time_us": {
            "type": "integer"
          },
          "pose": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          },
          "input_points": {
            "type": "integer",
            "minimum": 0
          },
          "added_points": {
            "type": "integer",
            "minimum": 0
          },
          "point_count": {
            "type": "integer",
            "minimum": 0
          },
          "processed_at": {
            "type": "string",
            "format": "date-time"
          },
          "depth_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rgb_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "depth": {
            "type": "string"
          },
          "rgb": {
            "type": "string"
          },
          "chunk": {
            "type": "string",
            "pattern": "^frame-[0-9]{4}\\.npz$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        },
        "required": [
          "index",
          "relative_time_us",
          "source_time_us",
          "pose",
          "input_points",
          "added_points",
          "point_count",
          "processed_at",
          "depth_sha256",
          "rgb_sha256",
          "depth",
          "rgb",
          "chunk",
          "sha256",
          "bytes"
        ]
      }
    }
  },
  "required": [
    "profile",
    "space_id",
    "job_id",
    "input_id",
    "snapshot_sha256",
    "tracking_sha256",
    "revision",
    "state",
    "frame_id",
    "axes",
    "unit",
    "input_frames",
    "available_frames",
    "processed_frames",
    "excluded_frames",
    "excluded_reason",
    "source_clock",
    "updated_at",
    "source_model_sha256",
    "project_id",
    "input_binding",
    "origin_time_us",
    "point_count",
    "frames"
  ]
}
