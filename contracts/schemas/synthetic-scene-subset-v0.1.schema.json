{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "entities",
            "geometry",
            "structure",
            "observations"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "maximum": 2097152,
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        },
        "depends_on": {
          "items": {
            "enum": [
              "entities",
              "geometry",
              "structure",
              "observations"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "role",
        "sha256",
        "bytes",
        "depends_on"
      ],
      "title": "Component",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Scene Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "snapshot_id",
        "sha256"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "cospace.synthetic-scene-subset/0.1",
      "title": "Profile",
      "type": "string"
    },
    "data_kind": {
      "const": "synthetic",
      "title": "Data Kind",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "subset_snapshot_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
      "title": "Subset Snapshot Id",
      "type": "string"
    },
    "requested_ids": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Requested Ids",
      "type": "array"
    },
    "dependency_ids": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Dependency Ids",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Components",
      "type": "array"
    },
    "selection": {
      "const": "explicit_entities_with_incident_connection_closure",
      "title": "Selection",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "data_kind",
    "source",
    "subset_snapshot_id",
    "requested_ids",
    "dependency_ids",
    "components",
    "selection"
  ],
  "title": "SubsetManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxture.local/schemas/synthetic-scene-subset-v0.1"
}
