{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxture.local/schemas/preview-objects-v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "model_id", "annotation_id", "created_at", "frame_id", "unit", "space_id", "project_id", "source_model_sha256", "ontology_ref", "base_candidate_ref", "objects"],
  "properties": {
    "profile": {"const": "cospace.preview-objects/0.1"},
    "model_id": {"type": "string", "pattern": "^build-[a-f0-9]{16}$"},
    "annotation_id": {"type": "string", "pattern": "^annotation-[a-f0-9]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "frame_id": {"type": "string", "minLength": 1},
    "unit": {"const": "m"},
    "space_id": {"type": "string", "pattern": "^space-[a-f0-9]{16}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-f0-9]{16}$"},
    "source_model_sha256": {"$ref": "#/$defs/sha256"},
    "ontology_ref": {
      "type": "object", "additionalProperties": false, "required": ["ontology_id", "version", "sha256"],
      "properties": {
        "ontology_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "base_candidate_ref": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "model_manifest_sha256"],
      "properties": {"candidate_id": {"type": "string", "minLength": 1}, "model_manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["object_id", "type_id", "properties", "anchor_m", "evidence", "confirmation"],
        "properties": {
          "object_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$"},
          "type_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "properties": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 4096}},
          "anchor_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "confirmation": {"const": "unverified"},
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["kind", "member", "sha256", "point_index"],
            "properties": {
              "kind": {"const": "model_point"}, "member": {"const": "spatial.npz"},
              "sha256": {"$ref": "#/$defs/sha256"}, "point_index": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
