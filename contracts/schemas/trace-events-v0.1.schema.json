{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schema_version","trace_id","scene_id","data_kind","agents","entities","activities","events"],
 "properties":{
  "schema_version":{"const":"cospace.trace-events/0.1"},"trace_id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},
  "agents":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["id","kind","label"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["person","software"]},"label":{"type":"string","minLength":1,"maxLength":256}}}},
  "entities":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["id","kind","member"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["source_snapshot","change","candidate","inspection","evidence"]},"member":{"$ref":"#/$defs/member"}}}},
  "activities":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["id","kind","agent_id","started_at","ended_at","used","generated"],"properties":{
   "id":{"$ref":"#/$defs/id"},"kind":{"enum":["candidate_build","candidate_inspection"]},"agent_id":{"$ref":"#/$defs/id"},"started_at":{"type":"string"},"ended_at":{"type":"string"},
   "used":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"generated":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
  }}},
  "events":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/event"}}
 },
 "$defs":{
  "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
  "member":{"type":"object","additionalProperties":false,"required":["path","bytes","sha256"],"properties":{"path":{"type":"string","minLength":1,"maxLength":256},"bytes":{"type":"integer","minimum":1,"maximum":8388608},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
  "eventref":{"type":"object","additionalProperties":false,"required":["source","id"],"properties":{"source":{"type":"string","pattern":"^urn:cospace:[A-Za-z0-9:._-]+$"},"id":{"$ref":"#/$defs/id"}}},
  "event":{"type":"object","additionalProperties":false,"required":["specversion","id","source","type","subject","time","datacontenttype","data"],"properties":{
   "specversion":{"const":"1.0"},"id":{"$ref":"#/$defs/id"},"source":{"type":"string","pattern":"^urn:cospace:[A-Za-z0-9:._-]+$"},
   "type":{"enum":["cospace.candidate.created.v1","cospace.candidate.inspected.v1"]},"subject":{"$ref":"#/$defs/id"},"time":{"type":"string"},"datacontenttype":{"const":"application/json"},
   "data":{"type":"object","additionalProperties":false,"required":["schema_version","trace_id","scene_id","data_kind","activity_id","entity_id","correlation_id","causation","authorized","robot_ready"],"properties":{
    "schema_version":{"const":"cospace.trace-event-data/0.1"},"trace_id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},"activity_id":{"$ref":"#/$defs/id"},"entity_id":{"$ref":"#/$defs/id"},"correlation_id":{"$ref":"#/$defs/id"},
    "causation":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/eventref"}]},"authorized":{"const":false},"robot_ready":{"const":false}
   }}
  }}
 }
}
