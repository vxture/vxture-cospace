{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schema_version","change_id","scene_id","data_kind","base","new_truth_id","new_objects_id","evidence","operations"],
 "properties":{
  "schema_version":{"const":"cospace.spatial-change/0.1"},"change_id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},
  "base":{"type":"object","additionalProperties":false,"required":["release_id","release_sha256","truth_id","truth_sha256"],"properties":{
   "release_id":{"$ref":"#/$defs/id"},"release_sha256":{"$ref":"#/$defs/sha"},"truth_id":{"$ref":"#/$defs/id"},"truth_sha256":{"$ref":"#/$defs/sha"}
  }},
  "new_truth_id":{"$ref":"#/$defs/id"},"new_objects_id":{"$ref":"#/$defs/id"},
  "evidence":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/member"}},
  "operations":{"type":"array","minItems":1,"maxItems":256,"items":{"oneOf":[{"$ref":"#/$defs/add"},{"$ref":"#/$defs/replace"},{"$ref":"#/$defs/remove"},{"$ref":"#/$defs/resource"}]}}
 },
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":256},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "member":{"type":"object","additionalProperties":false,"required":["id","path","sha256","bytes"],"properties":{"id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha"},"bytes":{"type":"integer","minimum":1,"maximum":8388608}}},
  "object":{"type":"object","additionalProperties":false,"required":["object_id","type_id","anchor"],"properties":{"object_id":{"$ref":"#/$defs/id"},"type_id":{"$ref":"#/$defs/id"},"anchor":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}}},
  "add":{"type":"object","additionalProperties":false,"required":["op","object"],"properties":{"op":{"const":"object.add"},"object":{"$ref":"#/$defs/object"}}},
  "replace":{"type":"object","additionalProperties":false,"required":["op","object","expected_object_sha256"],"properties":{"op":{"const":"object.replace"},"object":{"$ref":"#/$defs/object"},"expected_object_sha256":{"$ref":"#/$defs/sha"}}},
  "remove":{"type":"object","additionalProperties":false,"required":["op","object_id","expected_object_sha256"],"properties":{"op":{"const":"object.remove"},"object_id":{"$ref":"#/$defs/id"},"expected_object_sha256":{"$ref":"#/$defs/sha"}}},
  "resource":{"type":"object","additionalProperties":false,"required":["op","role","expected_sha256","replacement"],"properties":{"op":{"const":"resource.replace"},"role":{"enum":["geometry","coverage"]},"expected_sha256":{"$ref":"#/$defs/sha"},"replacement":{"$ref":"#/$defs/member"}}}
 }
}
