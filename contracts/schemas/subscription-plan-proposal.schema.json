{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoSpace local subscription planning document; not a platform API payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "profile", "status", "productCode", "billingScope", "currency", "commercialValuesApproved", "platformMutationExecuted", "serviceBoundary", "allSoftwareModules", "metricMapping", "resourceRules", "plans", "releaseBlockers"],
  "properties": {
    "$schema": {"type": "string"},
    "profile": {"const": "cospace.subscription-plan-proposal/0.1"},
    "status": {"const": "local_proposal_not_submitted"},
    "productCode": {"const": "cospace"},
    "billingScope": {"const": "workspace"},
    "currency": {"const": "CNY"},
    "commercialValuesApproved": {"const": false},
    "platformMutationExecuted": {"const": false},
    "allSoftwareModules": {"const": ["空间预览", "态势服务", "数据管理", "构建中心", "语义本体", "空间关联"]},
    "serviceBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["groundAcquisitionEngineeringIncluded", "commissionedProcessingEngineeringIncluded", "supportedAutomatedSoftwareIncluded", "publicText"],
      "properties": {
        "groundAcquisitionEngineeringIncluded": {"const": false},
        "commissionedProcessingEngineeringIncluded": {"const": false},
        "supportedAutomatedSoftwareIncluded": {"const": true},
        "publicText": {"type": "string", "pattern": "不包含地面采集处理工程", "minLength": 40}
      }
    },
    "metricMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["member.max", "scene.max", "storage.bytes", "ai.credit"],
      "properties": {
        "member.max": {"const": {"owner": "product", "kind": "max", "registration": "verify_in_live_catalog"}},
        "scene.max": {"const": {"owner": "product", "kind": "max", "registration": "proposed_key_not_registered"}},
        "storage.bytes": {"const": {"owner": "platform", "kind": "gauge", "registration": "reuse_platform_metric"}},
        "ai.credit": {"const": {"owner": "platform", "kind": "counter", "registration": "reuse_platform_metric"}}
      }
    },
    "resourceRules": {
      "const": {
        "storageUnitBytes": 1073741824,
        "storageContributionIsHardCap": false,
        "storageAddons": "platform_available_catalog_only",
        "aiReset": "monthly_subscription_anchor",
        "annualAiGrant": "monthly_not_upfront",
        "aiCarryover": "proposed_no_monthly_carryover",
        "modelUsageReporter": "atlas",
        "ordinaryGeometryBuildConsumesAiCredits": false,
        "historicalVersionsConsumeSceneSlots": false,
        "productSeatsAreWorkspaceMemberCount": false
      }
    },
    "plans": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/paidPlan"}, {"properties": {"tier": {"const": "pro"}, "planCode": {"const": "cospace-pro"}}}]},
        {"allOf": [{"$ref": "#/$defs/paidPlan"}, {"properties": {"tier": {"const": "business"}, "planCode": {"const": "cospace-business"}}}]},
        {"$ref": "#/$defs/enterprisePlan"}
      ]
    },
    "releaseBlockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "basePlan": {
      "type": "object",
      "required": ["planCode", "name", "tier", "componentRole", "fulfillment", "selfService", "prices", "componentQuotaProposal"],
      "properties": {
        "planCode": {"type": "string"}, "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["pro", "business", "enterprise"]},
        "componentRole": {"const": "primary"},
        "fulfillment": {}, "selfService": {}, "prices": {}, "componentQuotaProposal": {}
      },
      "additionalProperties": false
    },
    "paidPlan": {
      "allOf": [{"$ref": "#/$defs/basePlan"}],
      "properties": {
        "fulfillment": {"const": "paid_subscription"}, "selfService": {"const": true},
        "prices": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/price"}, {"properties": {"cycle": {"const": "month"}}}]},
            {"allOf": [{"$ref": "#/$defs/price"}, {"properties": {"cycle": {"const": "year"}}}]}
          ]
        },
        "componentQuotaProposal": {
          "type": "object", "additionalProperties": false,
          "required": ["member.max", "scene.max", "storage.bytes", "ai.credit"],
          "properties": {
            "member.max": {"type": "integer", "minimum": 1},
            "scene.max": {"type": "integer", "minimum": 1},
            "storage.bytes": {"type": "integer", "minimum": 1},
            "ai.credit": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "enterprisePlan": {
      "allOf": [{"$ref": "#/$defs/basePlan"}],
      "properties": {
        "planCode": {"const": "cospace-enterprise"}, "tier": {"const": "enterprise"},
        "fulfillment": {"const": "operator_grant_after_contract"}, "selfService": {"const": false},
        "prices": {"const": []}, "componentQuotaProposal": {"type": "null"}
      }
    },
    "price": {
      "type": "object", "additionalProperties": false, "required": ["cycle", "amountFen"],
      "properties": {"cycle": {"enum": ["month", "year"]}, "amountFen": {"type": "integer", "minimum": 1}}
    }
  }
}
