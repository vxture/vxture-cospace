{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "oneOf":[{"$ref":"#/$defs/truth"},{"$ref":"#/$defs/view"},{"$ref":"#/$defs/release"},{"$ref":"#/$defs/ontology"},{"$ref":"#/$defs/objects"},{"$ref":"#/$defs/frame"},{"$ref":"#/$defs/scope"}],
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":256},
  "ref":{"type":"object","additionalProperties":false,"required":["id","path","sha256","bytes"],"properties":{"id":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/id"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"bytes":{"type":"integer","minimum":1,"maximum":8388608}}},
  "truth":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","scene_id","data_kind","frame","scope","ontology","objects","geometry","coverage","provenance"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"truth"},"id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},
   "frame":{"$ref":"#/$defs/ref"},"scope":{"$ref":"#/$defs/ref"},"ontology":{"$ref":"#/$defs/ref"},"objects":{"$ref":"#/$defs/ref"},"geometry":{"$ref":"#/$defs/ref"},"coverage":{"$ref":"#/$defs/ref"},"provenance":{"$ref":"#/$defs/ref"}
  }},
  "view":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","scene_id","data_kind","view_kind","source_truth","frame","scope","ontology","quality","derivation","artifacts","object_ids","expression"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"view"},"id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},
   "view_kind":{"enum":["human","machine"]},"source_truth":{"$ref":"#/$defs/ref"},"frame":{"$ref":"#/$defs/ref"},"scope":{"$ref":"#/$defs/ref"},"ontology":{"$ref":"#/$defs/ref"},"quality":{"$ref":"#/$defs/ref"},"derivation":{"$ref":"#/$defs/ref"},
   "artifacts":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/ref"}},
   "object_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
   "expression":{"type":"object","additionalProperties":false,"required":["encoding","intended_use","losses","max_geometric_error_m","validation"],"properties":{
    "encoding":{"$ref":"#/$defs/id"},"intended_use":{"const":"synthetic_inspection"},
    "losses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "max_geometric_error_m":{"type":["number","null"],"minimum":0},"validation":{"const":"not_field_validated"}
   }}
  }},
  "release":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","scene_id","data_kind","source_truth","quality_profile","quality_assessment","views","adoption"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"release"},"id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"data_kind":{"const":"synthetic"},
   "source_truth":{"$ref":"#/$defs/ref"},"quality_profile":{"$ref":"#/$defs/ref"},"quality_assessment":{"$ref":"#/$defs/ref"},
   "views":{"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/$defs/ref"}},"adoption":{"const":"sample_only"}
  }},
  "ontology":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","version","type_ids"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"ontology"},"id":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"},"type_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
  }},
  "objects":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","frame_id","ontology","instances"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"objects"},"id":{"$ref":"#/$defs/id"},"frame_id":{"$ref":"#/$defs/id"},"ontology":{"$ref":"#/$defs/ref"},
   "instances":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["object_id","type_id","anchor"],"properties":{"object_id":{"$ref":"#/$defs/id"},"type_id":{"$ref":"#/$defs/id"},"anchor":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}}}}
  }},
  "frame":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","unit","handedness","axes","origin"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"frame"},"id":{"$ref":"#/$defs/id"},"unit":{"const":"m"},"handedness":{"const":"right"},"axes":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/id"}},"origin":{"$ref":"#/$defs/id"}
  }},
  "scope":{"type":"object","additionalProperties":false,"required":["schema_version","kind","id","frame_id","bounds","cell_size_m"],"properties":{
   "schema_version":{"const":"cospace.spatial-release/0.1"},"kind":{"const":"scope"},"id":{"$ref":"#/$defs/id"},"frame_id":{"$ref":"#/$defs/id"},"bounds":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}},"cell_size_m":{"type":"number","exclusiveMinimum":0}
  }}
 }
}
