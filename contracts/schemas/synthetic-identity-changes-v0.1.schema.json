{
  "$defs": {
    "IdentityEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "split",
            "merge",
            "unresolved"
          ],
          "title": "Kind",
          "type": "string"
        },
        "before_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Before Ids",
          "type": "array"
        },
        "after_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "After Ids",
          "type": "array"
        },
        "assessment": {
          "const": "unverified",
          "title": "Assessment",
          "type": "string"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "before_ids",
        "after_ids",
        "assessment",
        "reason"
      ],
      "title": "IdentityEvent",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Scene Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "snapshot_id",
        "sha256"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "cospace.synthetic-identity-changes/0.1",
      "title": "Profile",
      "type": "string"
    },
    "data_kind": {
      "const": "synthetic",
      "title": "Data Kind",
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "target": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/IdentityEvent"
      },
      "maxItems": 1000,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "profile",
    "data_kind",
    "base",
    "target",
    "events"
  ],
  "title": "IdentityChanges",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxture.local/schemas/synthetic-identity-changes-v0.1"
}
