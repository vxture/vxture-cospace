{
  "profile": "vxture.ontology-library/0.1",
  "modules": [
    {
      "profile": "vxture.ontology-module/0.1",
      "module_id": "core",
      "version": "0.1.0",
      "title": "通用核心",
      "description": "跨领域对象、空间、系统、角色、时间、观测和证据的候选定义。用于公共语义引用，不保存现场实例。",
      "layer": "core",
      "status": "draft",
      "requires": [],
      "concepts": {
        "entity": {
          "title": "实体",
          "definition": "具有可区分身份的描述对象；名称和数字记录不替代其身份。",
          "examples": [
            "某物理对象、空间或事件的身份"
          ],
          "counterexamples": [
            "仅凭同名确定为同一对象"
          ],
          "properties": {
            "name": {
              "title": "名称",
              "definition": "用于显示的名称，不作为实体身份。",
              "data_type": "string",
              "required": true
            }
          }
        },
        "physical_object": {
          "title": "物理对象",
          "definition": "在现实中具有物理存在的对象；与其数字记录和几何表达区分。",
          "examples": [
            "一台水泵"
          ],
          "counterexamples": [
            "水泵的资产台账记录"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "spatial_region": {
          "title": "空间区域",
          "definition": "在明确空间参照下界定的区域，边界和维度由实例表达声明。",
          "examples": [
            "房间空间、室外区域"
          ],
          "counterexamples": [
            "房间的墙体构件"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "system": {
          "title": "系统",
          "definition": "为某种功能组织起来的成员集合；成员关系不等同物理组成或空间包含。",
          "examples": [
            "供配电系统"
          ],
          "counterexamples": [
            "所有最近邻设备的临时集合"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "organization": {
          "title": "组织",
          "definition": "具有业务身份的组织主体；不隐含平台租户归属或权限。",
          "examples": [
            "园区运营公司"
          ],
          "counterexamples": [
            "平台的某一条访问令牌"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "role_assignment": {
          "title": "角色指派",
          "definition": "某主体或对象在指定范围和有效期内承担角色的记录。",
          "examples": [
            "设备在某期间被指定为巡检对象"
          ],
          "counterexamples": [
            "将巡检角色当作设备固有类型"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "observation": {
          "title": "观测",
          "definition": "某来源在某时刻通过某方法报告对象属性结果的活动记录，不自动成为已核实事实。",
          "examples": [
            "对某区域温度的一次报告"
          ],
          "counterexamples": [
            "设备额定温度参数"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "event": {
          "title": "事件",
          "definition": "在某时刻或区间发生的事情；来源报告与已确认发生须区分。",
          "examples": [
            "经确认的设备停运事件"
          ],
          "counterexamples": [
            "永久设备类型"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "evidence": {
          "title": "证据记录",
          "definition": "支持某项声明的可追溯资料或方法引用；引用完整不等于含义属实。",
          "examples": [
            "固定铭牌照片引用"
          ],
          "counterexamples": [
            "可变网页地址被当作固定字节证据"
          ],
          "properties": {},
          "parent": "core:entity"
        },
        "information_record": {
          "title": "信息记录",
          "definition": "描述对象或业务的信息载体，与其描述的现实对象分开。",
          "examples": [
            "资产主记录、巡检工单"
          ],
          "counterexamples": [
            "记录所描述的物理泵"
          ],
          "properties": {},
          "parent": "core:entity"
        }
      },
      "relations": {
        "located_in": {
          "title": "位于",
          "definition": "声明对象位于空间区域；声明与几何包含的核验分别处理。",
          "source_types": [
            "core:physical_object"
          ],
          "target_types": [
            "core:spatial_region"
          ],
          "symmetric": false
        },
        "part_of": {
          "title": "物理组成",
          "definition": "物理对象构成另一物理对象的一部分，不表达所在空间。",
          "source_types": [
            "core:physical_object"
          ],
          "target_types": [
            "core:physical_object"
          ],
          "symmetric": false
        },
        "member_of": {
          "title": "系统成员",
          "definition": "某对象为功能系统的成员，不推定其实际供给网络。",
          "source_types": [
            "core:physical_object"
          ],
          "target_types": [
            "core:system"
          ],
          "symmetric": false
        },
        "observes_subject": {
          "title": "观测主题",
          "definition": "将观测关联到被观测对象，不以传感器安装位置替代该对象。",
          "source_types": [
            "core:observation"
          ],
          "target_types": [
            "core:entity"
          ],
          "symmetric": false
        },
        "supported_by": {
          "title": "依据",
          "definition": "将声明的主题关联到证据记录；逐项断言证据须由消费契约细化。",
          "source_types": [
            "core:entity"
          ],
          "target_types": [
            "core:evidence"
          ],
          "symmetric": false
        }
      }
    },
    {
      "profile": "vxture.ontology-module/0.1",
      "module_id": "built_environment",
      "version": "0.2.0",
      "title": "建筑与空间",
      "description": "跨园区复用的建筑、楼层、空间与构件语义；空间用途、连接和现场核验需独立描述。",
      "layer": "domain",
      "status": "draft",
      "requires": [
        {
          "module_id": "core",
          "version": "0.1.0",
          "sha256": "d12aec3d679d5c06779e91faf44b4064dfee2a7cbdee2330b20e253b511f169f"
        }
      ],
      "concepts": {
        "site_region": {
          "title": "园区物理范围",
          "definition": "描述园区物理空间范围，不等同平台工作区或运营组织。",
          "examples": [
            "园区用地范围"
          ],
          "counterexamples": [
            "平台 Workspace"
          ],
          "properties": {},
          "parent": "core:spatial_region"
        },
        "building": {
          "title": "建筑",
          "definition": "现实建筑物，其物理身份与内部空间区域分开。",
          "examples": [
            "1号厂房建筑物"
          ],
          "counterexamples": [
            "厂房内的经营组织"
          ],
          "properties": {},
          "parent": "core:physical_object"
        },
        "level": {
          "title": "楼层空间",
          "definition": "用于组织建筑内部空间的层级区域，不等同楼板。",
          "examples": [
            "建筑二层空间"
          ],
          "counterexamples": [
            "二层楼板构件"
          ],
          "properties": {},
          "parent": "core:spatial_region"
        },
        "room": {
          "title": "房间空间",
          "definition": "由边界限定的建筑内部空间；设备、办公等用途另行声明。",
          "examples": [
            "办公室所在房间空间"
          ],
          "counterexamples": [
            "房间墙面网格"
          ],
          "properties": {},
          "parent": "core:spatial_region"
        },
        "corridor": {
          "title": "走廊空间",
          "definition": "承担建筑内部空间联系用途的通道区域，类别不保证当前可通行。",
          "examples": [
            "一层走廊区域"
          ],
          "counterexamples": [
            "机器人规划出的路径"
          ],
          "properties": {},
          "parent": "core:spatial_region"
        },
        "door": {
          "title": "门构件",
          "definition": "与开口相关的物理门构件；门洞尺寸、门扇与当前开闭报告分别表达。",
          "examples": [
            "房间入口门"
          ],
          "counterexamples": [
            "门当前处于关闭状态的报告"
          ],
          "properties": {},
          "parent": "core:physical_object"
        },
        "stair": {
          "title": "楼梯构件",
          "definition": "用于联系不同标高空间的物理构件，类别不证明任何设备可通过。",
          "examples": [
            "两层间的楼梯"
          ],
          "counterexamples": [
            "机器人上下楼轨迹"
          ],
          "properties": {},
          "parent": "core:physical_object"
        },
        "building_region": {
          "title": "建筑空间范围",
          "definition": "用于组织建筑内部空间的空间区域；与建筑物理实体分别标识，不把几何模型本身当作空间区域。",
          "examples": [
            "某栋建筑所对应的整体空间范围"
          ],
          "counterexamples": [
            "建筑外墙、建筑模型文件"
          ],
          "properties": {},
          "parent": "core:spatial_region"
        }
      },
      "relations": {
        "spatial_part_of": {
          "title": "空间层级归属",
          "definition": "空间区域属于另一空间区域的声明；只对配置指定的层级检查单父与无环，不用于管理分区。",
          "source_types": [
            "core:spatial_region"
          ],
          "target_types": [
            "core:spatial_region"
          ],
          "symmetric": false
        },
        "adjacent_to": {
          "title": "空间邻接",
          "definition": "空间具有经声明的邻接关系，不等于有开口、可互达或设备可通行。",
          "source_types": [
            "core:spatial_region"
          ],
          "target_types": [
            "core:spatial_region"
          ],
          "symmetric": true
        },
        "region_of_building": {
          "title": "对应建筑实体",
          "definition": "将建筑空间范围关联到其描述的建筑实体；不由同名或相交自动建立，不据此推导坐标或可通行性。",
          "source_types": [
            "built_environment:building_region"
          ],
          "target_types": [
            "built_environment:building"
          ],
          "symmetric": false
        }
      }
    },
    {
      "profile": "vxture.ontology-module/0.1",
      "module_id": "outdoor",
      "version": "0.1.0",
      "title": "室外空间与设施",
      "description": "室内外衔接及公共设施候选语义；不承载导航策略。",
      "layer": "domain",
      "status": "draft",
      "requires": [
        {
