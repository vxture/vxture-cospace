          "properties": {},
          "parent": "core:spatial_region"
        },
        "fence": {
          "title": "围栏",
          "definition": "界定或分隔空间的物理设施，不自动证明所有边界均封闭。",
          "examples": [
            "园区围栏段"
          ],
          "counterexamples": [
