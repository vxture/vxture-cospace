          "definition": "指派所记录的入驻或使用组织；组织与平台租户分别标识。",
          "source_types": [
            "operations:occupancy_assignment"
          ],
          "target_types": [
            "core:organization"
          ],
          "symmetric": false
        },
        "occupancy_space": {
          "title": "入驻空间",
          "definition": "指派所涉及的空间区域；有效期、依据和完整性在实例契约中约束，不将区域内所有设施视为归该组织所有。",
          "source_types": [
            "operations:occupancy_assignment"
          ],
          "target_types": [
            "core:spatial_region"
          ],
          "symmetric": false
        },
        "use_space": {
          "title": "用途空间",
          "definition": "用途指派所描述的空间；生产、研发、仓储等用途不替代房间或空间范围的实体类型。",
          "source_types": [
            "operations:space_use"
          ],
          "target_types": [
            "core:spatial_region"
          ],
          "symmetric": false
        },
        "responsible_organization": {
          "title": "责任组织",
          "definition": "设施职责指派的责任组织；不从组织名称、入驻或邻近位置推断。",
          "source_types": [
            "operations:responsibility_assignment"
          ],
          "target_types": [
            "core:organization"
          ],
          "symmetric": false
        },
        "responsibility_target": {
          "title": "职责对象",
          "definition": "设施职责指派涉及的物理对象、空间或系统；不等同所有权、故障因果或访问权限。",
          "source_types": [
            "operations:responsibility_assignment"
          ],
          "target_types": [
