            "core:spatial_region",
            "core:system"
          ],
          "symmetric": false
        },
        "management_scope": {
          "title": "职责管理范围",
          "definition": "设施职责指派适用的空间管理范围；该范围不由设备的几何包围盒自动生成。",
          "source_types": [
            "operations:responsibility_assignment"
          ],
          "target_types": [
            "operations:management_region"
          ],
          "symmetric": false
        },
        "asset_object": {
          "title": "记录描述对象",
          "definition": "资产记录所描述的物理对象；同一对象可有不同来源的多条记录，不按资产编号跨来源自动合并。",
          "source_types": [
            "operations:asset_record"
          ],
          "target_types": [
            "core:physical_object"
          ],
          "symmetric": false
        },
        "asset_custodian": {
          "title": "记录管理组织",
          "definition": "负责维护资产记录的组织；不据此推导物理对象所有者、设施运维责任或授权。",
          "source_types": [
            "operations:asset_record"
          ],
          "target_types": [
            "core:organization"
          ],
          "symmetric": false
        }
      }
    }
  ]
