ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Synthetic millimetre tessellation'),'2;1');
FILE_NAME('','2000-01-01T00:00:00',(''),(''),'CoSpace test fixture','','');
FILE_SCHEMA(('IFC4X3_ADD2'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT('Body','Model',3,0.001,#4,$);
#6=IFCPROJECT('0pvryC9GH7dwSTeFTioe5H',$,'Millimetre fixture',$,$,$,$,(#5),#2);
#7=IFCCARTESIANPOINT((10000.,20000.,30000.));
#8=IFCDIRECTION((0.,1.,0.));
#9=IFCAXIS2PLACEMENT3D(#7,$,#8);
#10=IFCLOCALPLACEMENT($,#9);
#11=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(1000.,0.,0.),(0.,1000.,0.),(0.,0.,1000.)),$);
#12=IFCTRIANGULATEDFACESET(#11,$,.T.,((1,3,2),(1,2,4),(1,4,3),(2,3,4)),$);
#13=IFCSHAPEREPRESENTATION(#5,'Body','Tessellation',(#12));
#14=IFCPRODUCTDEFINITIONSHAPE($,$,(#13));
#15=IFCWALL('3SsinFgj11_PlMXRWgnn8W',$,'Rotated millimetre wall',$,$,#10,#14,$,$);
ENDSEC;
END-ISO-10303-21;
